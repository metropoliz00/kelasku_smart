# URL Web App Google Apps Script (Opsional untuk GitHub Actions / build Vite)
# URL Web App bukan secret API key — juga bisa diisi di public/config.js atau melalui menu Koneksi GAS di halaman Login.
VITE_GAS_WEB_APP_URL=""

# GEMINI_API_KEY & APP_URL (bawaan environment AI Studio, tidak dipakai oleh build statis GitHub Pages)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
